# KitCheck settings. Every script in this folder reads this file.
#
# In a terminal, load it with:      source scripts/settings.env
# A value you export before loading wins over the default written here.

# ---- Account ----------------------------------------------------------------
# Your Hugging Face username (the account logged in on the PC with: hf auth login).
# An HF_USER exported before loading this file wins.
: "${HF_USER:=varunsatish2017}"

# ---- Arms (PC) --------------------------------------------------------------
# Ports by USB serial number, so plug-in order no longer matters
# (/dev/ttyACM0 and 1 swap depending on which arm is plugged in first).
# List them with: ls -l /dev/serial/by-id/
# The IDs name the calibration files made with lerobot-calibrate, in
# ~/.cache/huggingface/lerobot/calibration/. They must match those files.
: "${FOLLOWER_PORT:=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C124442-if00}"
: "${LEADER_PORT:=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C123870-if00}"
: "${FOLLOWER_ID:=follower}"
: "${LEADER_ID:=leader}"

# ---- Cameras (PC) -----------------------------------------------------------
# The kit has two cameras: one on the follower's gripper (wrist) and one on
# a jointed stand (front). That is setup A, the default below.
# Keep one setup for the whole event: leave exactly one CAMERAS line without
# a leading '#'. The names (front, wrist) must stay the same from the first
# recording to the last run, or a trained model will not load.
# Cameras are addressed by USB ID, not index: /dev/videoN numbers change
# after a replug. List them with: ls -l /dev/v4l/by-id/
# The gripper camera is the one with serial 202404160005; it needs MJPG to
# keep up at 30 fps.
# docs/history/01-workcell.md explains the setups.
WRIST_CAM=/dev/v4l/by-id/usb-icSpring_icspring_camera_202404160005-video-index0
FRONT_CAM=/dev/v4l/by-id/usb-icSpring_icspring_camera-video-index0
if [ -z "${CAMERAS:-}" ]; then
  # Setup A: gripper camera + the camera on the stand
  CAMERAS="{front: {type: opencv, index_or_path: ${FRONT_CAM}, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: ${WRIST_CAM}, width: 640, height: 480, fps: 30, fourcc: MJPG}}"

  # Setup B: gripper camera only
  # CAMERAS="{wrist: {type: opencv, index_or_path: ${WRIST_CAM}, width: 640, height: 480, fps: 30, fourcc: MJPG}}"
fi

# Extra options for the follower in every robot command. Retrying failed reads
# keeps a run going through an occasional bad packet on the shared USB hub.
: "${ROBOT_EXTRA_ARGS:=--robot.num_read_retries=10}"

# How a trained ACT model is run (try_model.sh and the runner). By default it
# plans 100 steps (3.3 s) and plays them all without looking again, so the last
# centimeters of a grasp are done blind. Re-planning from fresh camera images
# usually grasps more precisely; one re-plan takes about 17 ms on the PC's GPU.
#   POLICY_ARGS="--policy.n_action_steps=20"          re-plan every 20 steps (0.67 s)
#   POLICY_ARGS="--policy.n_action_steps=1 --policy.temporal_ensemble_coeff=0.01"
#                                                     re-plan every step, blend plans
: "${POLICY_ARGS:=}"
# A fixed correction added to the model's joint commands (kitcheck/rollout.py).
# Degrees per joint, e.g. ACTION_OFFSET="shoulder_pan.pos=-4". Leave it empty:
# tried on red step 10,000, it made grasps worse. The model steers from the
# cameras, sees the offset and compensates in other joints (it ended higher and
# just as far to the side). It could only help a model that does not react to it.
: "${ACTION_OFFSET:=}"

# ---- Recording (PC) -----------------------------------------------------------
# docs/history/03-recording.md explains these.
: "${DATA_DIR:=$HOME/kitcheck_data}"   # demonstrations: $DATA_DIR/pick_<item>
# Takes start on your key press (scripts/record.sh). A take stops on your key
# press or after REC_EPISODE_S seconds, whichever comes first, and is kept.
# Waiting between takes has no limit (an hour, which no pause should reach).
: "${REC_EPISODE_S:=20}"
: "${REC_RESET_S:=3600}"
# Camera view while recording: a Rerun server shown in the browser at
# http://127.0.0.1:9090. scripts/record.sh starts one if none is running.
: "${RERUN_PORT:=9876}"
: "${RERUN_WEB_PORT:=9090}"

# ---- Training recipe (cloud machine) ----------------------------------------
# docs/history/04-training.md and docs/history/09-notes.md explain these choices.
: "${TRAIN_BATCH_SIZE:=8}"        # the organizers' example uses 64
: "${TRAIN_STEPS:=60000}"         # about 55 minutes at the measured speed
: "${TRAIN_SAVE_FREQ:=10000}"     # a checkpoint about every 8 minutes
: "${RETRAIN_STEPS:=20000}"       # when continuing from an existing model
: "${LONG_STEPS:=150000}"         # overnight run
: "${LONG_SAVE_FREQ:=25000}"
: "${TRAIN_DEVICE:=cuda}"         # correct on the AMD GPU too
: "${TRAIN_WANDB:=true}"          # log the loss curve to Weights & Biases
: "${TRAIN_PUSH:=true}"           # upload the final model to Hugging Face

# ---- Optional voice (docs/history/10-voice.md) ----------------------------------------
# Making the voice clips needs an ElevenLabs key. Do NOT write it in this file:
# this file is shared. Export it in the terminal you build the clips from:
#     export ELEVENLABS_API_KEY=<your key>

export HF_USER FOLLOWER_PORT LEADER_PORT FOLLOWER_ID LEADER_ID CAMERAS ROBOT_EXTRA_ARGS POLICY_ARGS ACTION_OFFSET
export DATA_DIR REC_EPISODE_S REC_RESET_S RERUN_PORT RERUN_WEB_PORT
export TRAIN_BATCH_SIZE TRAIN_STEPS TRAIN_SAVE_FREQ RETRAIN_STEPS LONG_STEPS LONG_SAVE_FREQ
export TRAIN_DEVICE TRAIN_WANDB TRAIN_PUSH
